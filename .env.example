# --- App (all required; copy to .env and fill in) ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# GitHub (GITHUB_API is usually https://api.github.com)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
GITHUB_API=https://api.github.com

JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=

REDIS_URL=redis://127.0.0.1:6380

# Sequelize (must be exactly "true" or "false")
SEQUELIZE_LOGGING=false

# Postgres — development / test
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Used when NODE_ENV=test
DB_NAME_TEST=

# Postgres — production only (loaded when NODE_ENV=production)
DATABASE_URL=
# Must be "true" or "false"
DATABASE_SSL=false
